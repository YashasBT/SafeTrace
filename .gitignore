
@'
# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets.toml

# IDE and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Test and cache files
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Logs and temporary files
*.log
*.tmp

# Generated data and model artifacts
*.joblib
*.pkl
*.pickle
*.model

# Local databases
*.db
*.sqlite3
'@ | Set-Content -Encoding utf8 .gitignore
